# Copia este archivo como .env.local y rellena los valores reales.
# .env.local no se versiona (ver .gitignore).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role de Supabase — se salta RLS por completo.
# SOLO se usa en src/lib/supabase/admin.ts (código server-only). NUNCA prefijar
# con NEXT_PUBLIC_ ni importar admin.ts desde un componente 'use client'.
SUPABASE_SERVICE_ROLE_KEY=

# Umami Analytics (Cloud, región EU) — ID del sitio en cloud.umami.is
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Contraseña del panel interno /admin/ (leads, candidatos, empresas).
# Verificada server-side en src/app/api/admin/login/route.ts.
ADMIN_PASSWORD=
